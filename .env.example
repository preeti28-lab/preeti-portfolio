# ---------------------------------------------------------------------------
# Frontend environment variables (Vite)
# Copy this file to `.env` and fill in your own values.
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the contact-form API.
# Leave empty in dev to use the Vite proxy (/api -> http://localhost:5000).
VITE_API_URL=

# GitHub username used by the "Open Source" section (GitHub REST API).
VITE_GITHUB_USERNAME=preeti28-lab

# Public site URL, used for canonical + Open Graph tags.
VITE_SITE_URL=https://preeti28-lab.github.io
