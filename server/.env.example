# ---------------------------------------------------------------------------
# Backend environment variables — copy to server/.env
# ---------------------------------------------------------------------------

PORT=5000

# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,https://alexmorgan.dev

# SMTP credentials.
# Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-char-app-password

# Where contact-form messages are delivered (defaults to SMTP_USER).
CONTACT_RECEIVER=your.email@gmail.com

# Name used in the auto-reply signature.
OWNER_NAME=Alex Morgan
